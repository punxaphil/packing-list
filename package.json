    "@hello-pangea/dnd": "^18.0.1",
    "firebase": "^12.16.0",
    "framer-motion": "^12.42.2",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "globals": "^17.8.0",
