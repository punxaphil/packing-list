{
  "name": "packing-list",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "tsc": "tsc -b --watch",
    "prebuild": "npm run lint && tsc -b",
    "build": "npm run prebuild && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome check src",
    "lint:fix": "biome check src --fix --unsafe"
  },
